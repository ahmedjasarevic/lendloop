# Copy to `.env` (gitignored) and fill in.
#
# Anything marked [convex env] must ALSO be set on the deployment:
#   npx convex env set NAME value
# Local `.env` is not visible to Convex functions.

# ---------------------------------------------------------------- Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------- Convex
# Written automatically by `npx convex dev` into .env.local.
# Kept here so the shape of a complete environment is obvious.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment

# [convex env] Clerk issuer / Frontend API domain, JWT template named "convex"
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# [convex env] Comma separated. Promoted to admin on first sign-in.
ADMIN_EMAILS=you@example.com

# [convex env] Used for links inside notification emails
LENDLOOP_APP_URL=http://localhost:3000

# [convex env] Public webhook URL. Convex cannot reach localhost:
# use `ngrok http 5678` (or deploy n8n) and paste the public URL here.
N8N_REQUEST_WEBHOOK_URL=https://your-tunnel.ngrok-free.app/webhook/lendloop/request-event

# ---------------------------------------------------------------- Shared secrets
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set both in Convex (`npx convex env set`) and in the n8n container.
LENDLOOP_WEBHOOK_SECRET=
LENDLOOP_CALLBACK_SECRET=

# ---------------------------------------------------------------- n8n container
# HTTP actions URL, NOT the .convex.cloud client URL.
LENDLOOP_CONVEX_SITE_URL=https://your-deployment.convex.site
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
